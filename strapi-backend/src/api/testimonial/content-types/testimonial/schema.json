{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "displayName": "Testimonial",
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "description": "Written and video testimonials"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "quote": {
      "type": "richtext",
      "required": true
    },
    "author": {
      "type": "string",
      "required": true
    },
    "authorTitle": {
      "type": "string"
    },
    "mediaType": {
      "type": "enumeration",
      "enum": ["written", "video"],
      "default": "written"
    },
    "videoUrl": {
      "type": "string"
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::program.program"
    },
    "country": {
      "type": "string"
    },
    "location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::location.location"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
