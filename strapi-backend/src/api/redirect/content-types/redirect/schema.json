{
  "kind": "collectionType",
  "collectionName": "redirects",
  "info": {
    "displayName": "Redirect",
    "singularName": "redirect",
    "pluralName": "redirects",
    "description": "URL redirect rules"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fromPath": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "toPath": {
      "type": "string",
      "required": true
    },
    "redirectCode": {
      "type": "enumeration",
      "enum": ["permanent_301", "temporary_302"],
      "default": "permanent_301"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
