{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "displayName": "Team Member",
    "singularName": "team-member",
    "pluralName": "team-members",
    "description": "Board members and global team"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "title": {
      "type": "string"
    },
    "role": {
      "type": "enumeration",
      "enum": ["board", "global-team", "staff", "advisor"],
      "default": "global-team"
    },
    "region": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "bio": {
      "type": "richtext"
    },
    "shortBio": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "publicVisibility": {
      "type": "boolean",
      "default": true
    }
  }
}
