{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "displayName": "Page",
    "singularName": "page",
    "pluralName": "pages",
    "description": "Custom pages with dynamic zone page builder"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.rich-text",
        "sections.image-text",
        "sections.card-grid",
        "sections.statistics",
        "sections.cta-banner",
        "sections.video",
        "sections.faq-accordion",
        "sections.newsletter",
        "sections.contact-form",
        "sections.map",
        "sections.embed"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "parentPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page"
    },
    "showInSitemap": {
      "type": "boolean",
      "default": true
    },
    "workflowStatus": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published"],
      "default": "draft"
    }
  }
}
