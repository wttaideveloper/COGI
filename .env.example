# ============================================
# COGI Platform - Docker Compose Environment
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ============================================
# Database Configuration (Neon Postgres - hosted)
# ============================================
# Strapi uses the Neon connection string directly (no local PostgreSQL container).
# Get it from https://console.neon.tech -> Connect -> direct (non-pooled) string.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/cogi?sslmode=require
DATABASE_SSL=true

# ============================================
# Strapi Backend Configuration
# ============================================
STRAPI_PORT=1337
STRAPI_URL=http://localhost:1337

# Generate strong secrets - use: openssl rand -base64 32
APP_KEYS=["CHANGE_ME_key1","CHANGE_ME_key2","CHANGE_ME_key3","CHANGE_ME_key4"]
API_TOKEN_SALT=CHANGE_ME_api_token_salt
ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_secret
TRANSFER_TOKEN_SALT=CHANGE_ME_transfer_token_salt
JWT_SECRET=CHANGE_ME_jwt_secret
ENCRYPTION_KEY=CHANGE_ME_encryption_key

# ============================================
# Frontend Configuration
# ============================================
# These VITE_* URLs are baked into the frontend bundles at BUILD time.
# For production set them to the real public URL of the stack (the EC2 IP
# or domain). The stack is served with path prefixes on ONE host:
#   /              -> public website
#   /admin         -> admin portal
#   /api           -> Strapi API
#   /admin-strapi  -> Strapi admin
#
# VITE_STRAPI_URL=https://www.yourdomain.com     (same origin; appends /api)
# VITE_PUBLIC_SITE_URL=https://www.yourdomain.com
# VITE_ADMIN_SITE_URL=https://www.yourdomain.com/admin

# Local development defaults (also used as build fallbacks)
VITE_STRAPI_URL=http://localhost:1337
VITE_PUBLIC_SITE_URL=http://localhost
VITE_ADMIN_SITE_URL=http://localhost/admin
VITE_GIVELIVELY_URL=

# Newsletter confirmation + admin alert emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Companions of Grace <info@coginternational.org>
ADMIN_NOTIFY_EMAIL=info@coginternational.org

# Used by the local leads plugin to list/delete subscribers in Strapi
STRAPI_ADMIN_EMAIL=admin@cogi.local
STRAPI_ADMIN_PASSWORD=admin123

# ============================================
# Nginx / Ports
# ============================================
HTTP_PORT=80
HTTPS_PORT=443

# ============================================
# CORS (Strapi accepts comma-separated origins)
# ============================================
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:5174